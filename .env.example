# Export these variables in your shell; .env is not loaded automatically.
# Use a unique strong password. Never commit live credentials.
ADMIN_EMAIL=operator@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Set behind a trusted HTTPS reverse proxy:
# SECURE_COOKIES=1
# HOST=127.0.0.1
# DATABASE_PATH=data/izi.sqlite
# Vercel requires a server-only PostgreSQL URL (never a NEXT_PUBLIC variable):
# DATABASE_URL=postgresql://izicyber_runtime.PROJECT_REF:PASSWORD@EXACT_POOLER_HOST:6543/postgres
# To start only one independently hosted interface:
# SURFACE=admin
# PORT=3002

# M-Pesa is disabled by default. These values belong only in your environment.
# Use a separate database for sandbox testing; never mix sandbox and live records.
MPESA_ENABLED=0
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=your-daraja-app-key
# MPESA_CONSUMER_SECRET=your-daraja-app-secret
# MPESA_SHORTCODE=your-registered-shortcode
# MPESA_PASSKEY=your-lipa-na-mpesa-passkey
# MPESA_CALLBACK_BASE=https://customer.your-domain
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
