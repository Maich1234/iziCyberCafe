# Export these variables in your shell; .env is not loaded automatically.
# Use a unique strong password. Never commit live credentials.
ADMIN_EMAIL=operator@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Set behind a trusted HTTPS reverse proxy:
# SECURE_COOKIES=1
# HOST=127.0.0.1
# DATABASE_PATH=data/izi.sqlite
# To start only one independently hosted interface:
# SURFACE=admin
# PORT=3002
